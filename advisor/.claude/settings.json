{
  "model": "fable",
  "effortLevel": "high",
  "agent": "advisor",
  "crossSessionInbound": "accept",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Write",
      "Edit",
      "NotebookEdit",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(rm:*)"
    ]
  }
}
